<%- include("include/head.ejs") %>
<body>
    <h1>Instagram</h1>
    <p>your username is: @<%= data.name %></p>
    <button> Follow </button>
    <button> Message</button>
    <p>Followers : <%= data.followers %> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    Following : <%= data.following %></p> 
    <hr>
    <% for(let post of data.posts){ %>
        <img src="<%= post.image %>" alt="this is the post img" width="300px" height="300px">
         <p>Liks : <%= post.likes %> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
           Comments : <%= post.comments %></p> 

   <%  } %>
   <%- include("include/footer.ejs") %>
</body>
</html>

